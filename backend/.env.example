# Google Maps API Key (Routes, Places, Elevation, Solar, Street View)
GOOGLE_MAPS_API_KEY=

# Gemini API Key (or Google Cloud Vertex AI credentials)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Gemini LLM Model (e.g. gemini-3.8-flash, gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-3.8-flash

# Street View画像の構造化解析にはGeminiを使用
# 画像解析だけ別モデルにする場合（未設定ならGEMINI_MODELを使用）
# STREET_VIEW_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: EmbeddingGemma 2 270M text model path (bundled by backend/Dockerfile)
# EMBEDDINGGEMMA_MODEL_PATH=/app/models/embeddinggemma-2-text-270m.litertlm

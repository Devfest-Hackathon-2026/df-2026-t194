# Google Maps JavaScript API用。Firebase認証のキーとは分ける。
VITE_GOOGLE_MAPS_API_KEY=
# Firebase Console → プロジェクト設定 → WebアプリのFirebase構成。
# ローカルViteには /__/firebase/init.json がないため必須。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=learned-now-513800-i6
VITE_FIREBASE_AUTH_DOMAIN=learned-now-513800-i6.firebaseapp.com
